<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/mysql-bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="MySQL financial workflows">
            <file>tests/Database/CiFixtureIsolationTest.php</file>
            <file>tests/Feature/ReportHistoryAccessTest.php</file>
            <file>tests/Feature/ReportGenerationBoundaryTest.php</file>
            <file>tests/Feature/SettlementCorrectionTest.php</file>
            <file>tests/Feature/CaseUpdateTest.php</file>
            <file>tests/Feature/LienWorkflowTest.php</file>
            <file>tests/Feature/InsuranceClaimWorkflowTest.php</file>
            <file>tests/Feature/PaymentReconciliationTest.php</file>
            <file>tests/Feature/SigningWorkflowTest.php</file>
            <file>tests/Feature/SignedDocumentArchiveTest.php</file>
            <file>tests/Feature/SigningRecoveryTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="FAYDAMED_MYSQL_CI" value="1" force="true"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="faydamed_ci" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
