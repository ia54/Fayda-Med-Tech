# SSH-only staging. Bind every listener to 127.0.0.1; use staging:check --loopback.
APP_NAME="FaydaMedTech Synthetic Staging"
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=http://127.0.0.1:18080
FRONTEND_URL=http://127.0.0.1:13005
PUBLIC_URL=http://127.0.0.1:18081
CORS_ALLOWED_ORIGINS=http://127.0.0.1:13005,http://127.0.0.1:18081
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=faydamed_staging
DB_USERNAME=faydamed_staging
DB_PASSWORD=
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=faydamed_staging_session
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
MAIL_MAILER=array
MAIL_FROM_ADDRESS=synthetic@example.invalid
BROADCAST_DRIVER=log
PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=
DOCUSIGN_BASE_URI=https://demo.docusign.net
DOCUSIGN_WEBHOOK_SECRET=
# No production database, SMTP, storage, payment, AI or signing credentials.
