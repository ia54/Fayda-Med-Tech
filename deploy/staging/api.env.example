# Proposed values only. Select and provision actual staging hosts first.
APP_NAME="FaydaMedTech Synthetic Staging"
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=https://staging-api.example.invalid
FRONTEND_URL=https://staging-admin.example.invalid
CORS_ALLOWED_ORIGINS=https://staging-admin.example.invalid
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=faydamed_staging
DB_USERNAME=faydamed_staging
